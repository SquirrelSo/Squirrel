# Leave everything empty for demo mode. On a phone, use your computer's LAN IP, not localhost.
# Only public URLs belong here: EXPO_PUBLIC_* values ship inside the app.

# Exercise Mechanics backend (FastAPI). Also where accounts live: the email-code sign-in uses its
# /api/auth, and the same token works on the Run Module and the Social service.
EXPO_PUBLIC_EXERCISE_API_URL=
# Run Module backend (runs, territory tiles, XP, leaderboards). Same JWT settings as the Exercise backend.
EXPO_PUBLIC_API_URL=
# Social service (profile, crews, events, duels, XP and hostel boards, notifications; routes under /v1).
# The campus screens run on it through src/api/campus/social.ts. Local dev: http://localhost:8100
EXPO_PUBLIC_SOCIAL_API_URL=
# Optional: a separate account server. Defaults to EXPO_PUBLIC_EXERCISE_API_URL.
EXPO_PUBLIC_AUTH_URL=
# Optional: a dedicated campus backend speaking the full contract (src/api/campus/types.ts).
# Empty: the Social service. Empty and no Social URL + dev build = in-memory dev mock.
EXPO_PUBLIC_CAMPUS_API_URL=
# Optional: campus-service (campus-service/ in this repo; routes under /v1). With the Social service
# set, the map world moves here — zones, territory + claim/steal/defend, run → zone eligibility,
# map players/presence, Active now, Open to Meet, shared zones and the heatmap — while profiles,
# crews, events, challenges, boards, notifications… stay on Social. Empty: no change. Local dev: http://localhost:8080
EXPO_PUBLIC_CAMPUS_SERVICE_URL=
# Optional WebSocket for live updates (the backend's GET /v1/config can also announce it)
EXPO_PUBLIC_REALTIME_URL=
# Optional: a folder serving MediaPipe's vision_bundle.mjs, wasm/ and pose_landmarker_lite.task for
# live workouts. Empty: jsDelivr and Google's model storage.
EXPO_PUBLIC_POSE_ASSETS_URL=
# Development only: 1 shows the pose debug overlay on the workout screen. Never in a production build.
EXPO_PUBLIC_POSE_DEBUG=

# Per-endpoint opt-in for campus capabilities whose backend has shipped (see src/api/availability.ts).
# Comma-separated: sharedZones, heatmap, dateSuggestions, media, meetupRating, ambassador, profileDetails, sharedWorkout
EXPO_PUBLIC_LIVE_ENDPOINTS=
