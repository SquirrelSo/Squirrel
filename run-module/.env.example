# Environment variable reference for the Run Module backend
# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example belongs in the repository.

# PostgreSQL connection string
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5434/run_module

# Redis connection URL
# Format: redis://[:<password>@]<host>:<port>[/<db-number>]
REDIS_URL=redis://localhost:6379

# HTTP server port
PORT=3000

# Runtime environment: development | test | production
NODE_ENV=development

# Pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Optional: web app origins allowed to call this API from a browser (src/api/cors.ts),
# comma-separated; `*` matches one part of a host name. Unset: none.
# CORS_ALLOWED_ORIGINS=https://squirrel-social.vercel.app

# Optional: per-user requests per minute for the app's XP reads (GET /v1/xp/stats, /v1/xp/history,
# /v1/leaderboard/xp). Default 120.
# RATE_LIMIT_XP_READ_PER_MIN=120

# Optional: 1 runs the background workers inside the API process (src/workers/all.ts), for hosts
# without background workers (Render's free plan). Unset: run `npm run worker` separately.
# RUN_WORKERS_IN_API=1

# ── JWT verification (RM-0c) ─────────────────────────────────────────────────

# Secret used to verify JWT signatures.
# For HS256 (development only): any sufficiently long random string (32+ chars).
# For RS256 (required in production): the PEM-encoded RSA public key of the
# account service that issues tokens.
# NEVER put a real key in this file — this file is committed. Use .env (gitignored).
JWT_SECRET=CHANGE_ME_TO_A_REAL_SECRET_OR_RSA_PUBLIC_KEY

# JWT signing algorithm. Allowed values: HS256 | RS256
# Default when not set: HS256  (development only — see ADR-003)
# MUST be RS256 before any real user data is involved.
JWT_ALGORITHM=HS256

# Optional: expected issuer (iss) claim. Leave unset to skip issuer check.
# JWT_ISSUER=https://accounts.example.com

# Optional: expected audience (aud) claim. Leave unset to skip audience check.
# JWT_AUDIENCE=run-module
