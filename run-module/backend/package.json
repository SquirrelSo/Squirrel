{
  "name": "run-module-backend",
  "version": "0.1.0",
  "description": "Run Module backend \u00e2\u20ac\u201d GPS tracking, territory, leaderboard",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "seed:territory": "node --env-file=.env --import tsx/esm scripts/seed-test-territory.ts",
    "dev": "node --env-file=.env --import tsx/esm src/api/server.ts",
    "worker": "node --env-file=.env --import tsx/esm src/workers/start.ts",
    "build": "tsc --project tsconfig.json",
    "lint": "eslint src scripts --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env ./node_modules/vitest/vitest.mjs run",
    "test:geometry": "node --env-file=.env ./node_modules/vitest/vitest.mjs run src/geometry/",
    "migrate": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migrations-dir ../db/migrations --database-url-var DATABASE_URL",
    "seed:dev": "node --env-file=.env --import tsx/esm scripts/seed-territories.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "bullmq": "^5.0.0",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.3.2",
    "jose": "^6.2.12",
    "node-pg-migrate": "7.9.1",
    "pg": "^8.12.0",
    "pino": "^9.0.0",
    "proj4": "^2.22.0"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@types/mapbox__vector-tile": "^1.3.4",
    "@types/node": "^22.0.0",
    "@types/pbf": "^3.0.5",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "geographiclib-geodesic": "^2.2.0",
    "pbf": "^5.1.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
