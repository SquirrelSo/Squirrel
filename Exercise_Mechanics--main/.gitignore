# macOS and editor metadata
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Local agent settings
.claude/settings.local.json

# Python environments, bytecode, caches and coverage
.venv/
venv/
env/
test_env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Frontend dependencies and generated build output
node_modules/
frontend-dist/
*.tsbuildinfo

# Local environment files and credentials
.env
.env.*
!.env.example

# Runtime user data and private/raw captures
data/users/*
!data/users/.gitkeep
backend_old/users/
backend_old/baseline/
data/captures/
# Moderation reports: who reported whom, and why — private, never committed
data/moderation/
