# Next to the Exercise backend and the Run Module (render.yaml, docker-compose.yml) the SOCIAL_*
# settings below can stay unset: DATABASE_URL, JWT_SECRET + JWT_ALGORITHM (their HS256 sign-in
# tokens) and CORS_ALLOWED_ORIGINS are read instead (app/config.py).

# Database (PostgreSQL in production; sqlite:///./social.db works for local development)
SOCIAL_DATABASE_URL=postgresql+psycopg://social:social@localhost:5432/social

# Token verification — REQUIRED (the service refuses to start without one of these).
# Same RS256 tokens the Run Module accepts. Use the account service's public key or JWKS.
SOCIAL_JWT_PUBLIC_KEY_FILE=dev-keys/public.pem
# SOCIAL_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# SOCIAL_JWKS_URL=https://auth.squirrelsocial.in/.well-known/jwks.json
# SOCIAL_JWT_ALGORITHMS=RS256
# SOCIAL_JWT_ISSUER=
# SOCIAL_JWT_AUDIENCE=

# Run Module (XP + run stats are read from here with the caller's token). Unset: XP shows the
# last synced value (0 for new users) and sharing runs returns 503.
SOCIAL_RUN_MODULE_URL=
# SOCIAL_RUN_MODULE_TIMEOUT_S=4
# Other people's XP is cached this long (seconds) before a list asks the Run Module again.
# SOCIAL_XP_CACHE_TTL_S=300

# Shared secret for POST /internal/v1/activities (service-to-service). Unset: endpoint disabled.
SOCIAL_INTERNAL_TOKEN=

# Progression (must match the app)
# SOCIAL_XP_PER_LEVEL=2000
# SOCIAL_STREAK_TIMEZONE=Asia/Kolkata

# Media uploads (S3-compatible). Unset bucket: upload endpoints return 503.
# SOCIAL_MEDIA_BUCKET=
# SOCIAL_MEDIA_REGION=
# SOCIAL_MEDIA_ENDPOINT_URL=       # R2 / MinIO
# SOCIAL_MEDIA_PUBLIC_BASE_URL=    # CDN in front of the bucket; else presigned GET URLs
# SOCIAL_MEDIA_MAX_BYTES=10485760
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=   (standard boto3 credentials)

# Browser origins allowed to call the API (Expo web). Native apps don't need CORS.
# SOCIAL_CORS_ORIGINS=http://localhost:8081
# SOCIAL_RATE_LIMITS=on

# --- community ---------------------------------------------------------------------------------
# Hostels members pick from (hostel vs hostel), comma-separated. Unset: hidden.
# SOCIAL_HOSTELS=Hostel A,Hostel B
# Named campus zones for Squirrel Dates: a JSON file (or the JSON inline in SOCIAL_ZONES), e.g.
#   [{"id": "library", "name": "Library", "polygon": [[22.96, 88.52], [22.96, 88.53], [22.97, 88.53]]},
#    {"id": "track", "name": "Sports Ground Loop", "center": [22.965, 88.52], "radius_m": 120}]
# Unset: Squirrel Dates says the zones aren't set up yet.
# SOCIAL_ZONES_FILE=/etc/secrets/campus-zones.json
# Activity badges, in SOCIAL_COMMUNITY_TIMEZONE: Early Bird = N activities started from FROM_HOUR to
# before HOUR, Night Owl = N started from its hour to before Early Bird's FROM_HOUR, Park Regular =
# the same zone on N different days.
# SOCIAL_EARLY_BIRD_FROM_HOUR=4
# SOCIAL_EARLY_BIRD_HOUR=7
# SOCIAL_EARLY_BIRD_ACTIVITIES=5
# SOCIAL_NIGHT_OWL_HOUR=21
# SOCIAL_NIGHT_OWL_ACTIVITIES=5
# SOCIAL_PARK_REGULAR_DAYS=5
# The web app's address, for invite links.
# SOCIAL_APP_URL=https://squirrel-social.vercel.app
# Pushes via Expo (on unless off); an access token only if the Expo project requires one.
# SOCIAL_PUSH=on
# SOCIAL_PUSH_RECEIPTS=on   # read Expo receipts ~15 min after each push; log failures, disable dead tokens
# EXPO_ACCESS_TOKEN=

# Ambassador Applications
# SOCIAL_AMBASSADOR_OPEN=off
# SOCIAL_AMBASSADOR_REAPPLY_DAYS=30
