# ---- Server ----
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated allowed origins for CORS (Expo web dev server etc). Empty = same-origin only.
# Patterns allowed: https://squirrel-*.vercel.app (* = letters, digits, hyphens; never a dot).
CORS_ORIGINS=http://localhost:8081

# ---- Database (PostgreSQL 14+ with PostGIS 3) ----
DATABASE_URL=postgres://campus:campus@localhost:5432/campus
DATABASE_POOL_MAX=10

# ---- Start-up (single-service deploys, e.g. one free Render web service) ----
# 1 = apply migrations/*.sql (each once, advisory-locked) before the API listens. Idempotent.
MIGRATE_ON_START=0
# 1 = upsert the 5 hostels + 16 placeholder zones before listening (never dev users or the dev crew).
# Idempotent; geometry is only overwritten while a zone's geometry_source is still 'dev_placeholder'.
SEED_ZONES_ON_START=0

# ---- Auth: verify the same RS256 bearer tokens the Run Module accepts ----
# One of AUTH_JWKS_URL or AUTH_PUBLIC_KEY_PEM is REQUIRED in production.
# Production (Exercise backend tokens): AUTH_JWKS_URL=https://squirrel-exercise.onrender.com/api/auth/jwks.json
AUTH_JWKS_URL=
AUTH_PUBLIC_KEY_PEM=
# Optional claim checks (leave empty to skip). Leave BOTH EMPTY for Exercise tokens: they carry neither claim.
# How long to wait for AUTH_JWKS_URL (ms). A sleeping free-plan Exercise backend takes ~1 min to wake;
# meanwhile requests get 503 auth_unreachable (retry), never 401.
AUTH_JWKS_TIMEOUT_MS=15000
AUTH_ISSUER=
AUTH_AUDIENCE=
# DEV ONLY: HS256 secret used by `npm run dev:token` to mint local tokens. Ignored when NODE_ENV=production.
AUTH_DEV_HS256_SECRET=dev-only-change-me

# ---- Identity bridge to the Social service (optional) ----
# Set BOTH to turn it on: every user id sent to clients becomes the Social profile id, names/avatars
# (and hostel, when Social has one) come from Social, and profile ids are accepted wherever a user id is.
# Leave either empty: ids are JWT subs and names are campus names (previous behaviour).
# e.g. SOCIAL_API_URL=https://squirrel-social.onrender.com — the token is Social's internal token (a secret).
SOCIAL_API_URL=
SOCIAL_INTERNAL_TOKEN=
# Per-call timeout (Social down/slow → campus fallback, never a 5xx) and cache TTL for resolved people.
SOCIAL_TIMEOUT_MS=3000
SOCIAL_CACHE_TTL_SECONDS=300
# WI-07: 1 (default) unions the legacy local `blocks` table with Social's blocks. Set 0 right after
# social-backend/scripts/import_blocks.py has copied those rows into Social: then Social alone decides.
LEGACY_LOCAL_BLOCKS=1

# ---- Campus ----
CAMPUS_ID=iiser-kolkata
CAMPUS_NAME=IISER Kolkata
CAMPUS_SHORT_NAME=IISER K
CAMPUS_EMAIL_DOMAINS=iiserkol.ac.in
CAMPUS_CENTER_LAT=22.9637
CAMPUS_CENTER_LNG=88.5245
# Points further than this from the campus centre are rejected at ingest (metres)
CAMPUS_MAX_RADIUS_M=4000

# ---- Realtime ----
# Public WebSocket URL announced in GET /v1/config (e.g. wss://api.squirrelsocial.in/v1/realtime). Empty = clients refresh on focus.
REALTIME_PUBLIC_URL=
# Postgres LISTEN/NOTIFY channel used to fan events out across API instances
REALTIME_PG_CHANNEL=campus_events

# ---- Verification worker ----
WORKER_POLL_MS=1000
WORKER_CONCURRENCY=2
WORKER_MAX_ATTEMPTS=5
# Run the worker inside the API process (fine for a single instance / dev). Set 0 and run `npm run start:worker` separately in prod.
WORKER_INLINE=1

# ---- Game rules (see src/territory/rules.ts for defaults) ----
QUALIFICATION_TTL_HOURS=24
CLAIM_SHIELD_HOURS=2
USER_ACTION_COOLDOWN_SECONDS=60
DEFEND_COOLDOWN_MINUTES=60
AREA_ZONE_DEFAULT_THRESHOLD=0.6
ROUTE_ZONE_DEFAULT_THRESHOLD=0.8
AREA_COVERAGE_BUFFER_M=15
ROUTE_MATCH_TOLERANCE_M=20
XP_CLAIM=25
XP_STEAL=40
XP_DEFEND=15

# ---- Presence / privacy ----
PRESENCE_TTL_MINUTES=15
PRESENCE_GRID_M=100
NEARBY_RADIUS_M=800
